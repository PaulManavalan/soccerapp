# Keep this value private. It must exactly match the Supabase Edge Function secret.
DUEL_ANALYSIS_WORKER_SECRET=replace-with-a-long-random-value

# Local development uses Ollama at no per-clip cost. The worker can also use OpenAI later.
ANALYSIS_PROVIDER=ollama
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=gemma3

# Required only when ANALYSIS_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Required only by local_poller.py. Copy the secret/service-role key from
# Supabase Project Settings -> API Keys. Keep it only in this local .env file.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_CALLBACK_URL=https://your-project.supabase.co/functions/v1/complete-duel-analysis
POLL_INTERVAL_SECONDS=8
